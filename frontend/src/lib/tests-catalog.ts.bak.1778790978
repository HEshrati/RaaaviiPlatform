export type AnswerScale =
  | "likert5"
  | "likert7"
  | "frequency4"
  | "yesno"
  | "paired";

export interface Option {
  value: number;
  label: string;
}

export interface Question {
  id: number;
  text: string;
  reverse?: boolean;
  subscale?: string;
}

export interface TestDef {
  id: string;
  name: string;
  shortName: string;
  phase: 1 | 2 | 3;
  category: string;
  description: string;
  estimatedMinutes: number;
  scale: AnswerScale;
  options: Option[];
  questions: Question[];
  scoring: {
    subscales?: { key: string; label: string; ids: number[] }[];
    ranges: {
      min: number;
      max: number;
      label: string;
      color: string;
      description: string;
    }[];
  };
  matchingWeight: number; // 0-10
}

const LIKERT5: Option[] = [
  { value: 1, label: "کاملاً مخالفم" },
  { value: 2, label: "مخالفم" },
  { value: 3, label: "نظری ندارم" },
  { value: 4, label: "موافقم" },
  { value: 5, label: "کاملاً موافقم" },
];

const AGREE7: Option[] = [
  { value: 1, label: "کاملاً مخالفم" },
  { value: 2, label: "بیشتر مخالفم" },
  { value: 3, label: "تا حدی مخالفم" },
  { value: 4, label: "نظری ندارم" },
  { value: 5, label: "تا حدی موافقم" },
  { value: 6, label: "بیشتر موافقم" },
  { value: 7, label: "کاملاً موافقم" },
];

const FREQ4: Option[] = [
  { value: 1, label: "هرگز" },
  { value: 2, label: "به‌ندرت" },
  { value: 3, label: "گاهی" },
  { value: 4, label: "اغلب" },
];

export function scoreAnswer(
  value: number,
  reverse: boolean,
  scale: AnswerScale,
): number {
  if (!reverse) return value;

  switch (scale) {
    case "likert5":
      return 6 - value;
    case "likert7":
      return 8 - value;
    case "frequency4":
      return 5 - value;
    case "yesno":
      return value === 1 ? 2 : 1;
    case "paired":
      return value;
    default:
      return value;
  }
}

export function calculateTotalScore(
  answers: Record<number, number>,
  questions: Question[],
  scale: AnswerScale,
): number {
  return questions.reduce((sum, q) => {
    const raw = answers[q.id];
    if (typeof raw !== "number") return sum;
    return sum + scoreAnswer(raw, !!q.reverse, scale);
  }, 0);
}

