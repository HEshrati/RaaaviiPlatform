export const TESTS_CATALOG: TestDef[] = [
  NEO_FFI,
  ECR_R,
  GOTT_MAN,
  MBTI_INSPIRED,
  HEXACO,
];

// lookup سریع بر اساس id
export const TESTS_BY_ID: Record<string, TestDef> = Object.fromEntries(
  TESTS_CATALOG.map((t) => [t.id, t]),
);

