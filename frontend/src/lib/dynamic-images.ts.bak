/* ── کلمات کلیدی loremflickr — چند گزینه برای تنوع ── */
const CATEGORY_KEYWORDS: Record<string, string[]> = {
  hambazi: ["boardgame,friends,playing", "friends,games,laughing", "tabletop,game,fun", "cards,friends,cafe"],
  hamneshin: ["friends,cafe,coffee", "people,cafe,talking", "friends,sitting,warm", "coffee,cozy,friends"],
  hamgharar: ["breakfast,friends,food", "brunch,people,happy", "food,morning,friends", "meal,gathering,people"],
  hamsohbat: ["conversation,cafe,two", "talking,friends,coffee", "discussion,people,cafe", "chat,friends,table"],
  hampa: ["hiking,nature,friends", "walking,mountain,people", "trail,outdoor,group", "nature,walk,friends"],
  hamghadam: ["walking,park,friends", "jogging,outdoor,people", "path,nature,walk", "park,friends,stroll"],
  hamamooz: ["workshop,learning,group", "study,people,table", "education,team,laptops", "classroom,students,work"],
  hamkar: ["business,team,handshake", "office,colleagues,work", "professional,meeting,team", "coworking,people,desk"],
  hamfekr: ["brainstorm,office,sticky", "ideas,team,whiteboard", "creative,thinking,group", "startup,team,planning"],
  hamteymi: ["sport,team,energy", "players,team,field", "athletes,group,sport", "team,cheering,sport"],
  hamghesse: ["books,reading,cozy", "library,people,reading", "storytelling,friends,books", "bookshop,warm,reading"],
  hamvision: ["future,team,vision", "planning,group,goals", "strategy,business,team", "leadership,group,discuss"],
  hamhonar: ["art,creative,painting", "artists,studio,work", "music,friends,creative", "craft,people,workshop"],
  hamvarzesh: ["sport,fitness,active", "gym,people,exercise", "running,outdoor,group", "yoga,group,healthy"],
  hamnegah: ["photography,creative,art", "cinema,friends,watching", "gallery,people,art", "exhibition,group,art"],
  hamziste: ["meditation,garden,peace", "nature,mindful,calm", "yoga,outdoor,peace", "wellness,group,nature"],
  hamravan: ["therapy,support,group", "counseling,people,calm", "mental,health,support", "circle,people,sharing"],
  dustravan: ["psychology,friends,talk", "support,friends,warm", "listening,care,people", "friendship,support,cafe"],
  default: ["social,gathering,people", "friends,meeting,happy", "group,people,together", "community,friends,smile"],
};

function strHash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) { h = (h << 5) - h + s.charCodeAt(i); h |= 0; }
  return Math.abs(h);
}

/* ── API اصلی ── */

export function getEventImage(
  category?: string,
  eventId?: string,
  fallback?: string
): string {
  // اگه image_url واقعی از بک‌اند داریم، اون رو برگردون
  if (fallback && fallback.startsWith('/api/')) return fallback;
  const cat  = (category || "default").toLowerCase();
  const opts = CATEGORY_KEYWORDS[cat] || CATEGORY_KEYWORDS.default;
  // seed از eventId → هر ایونت همیشه همون عکس خودش رو داره
  const seed = eventId ? strHash(eventId) : Math.floor(Math.random() * 9999);
  const kw = opts[seed % opts.length];
  const lock = seed % 500;
  return `https://loremflickr.com/400/220/${kw}?lock=${lock}`;
}

export function getEventImageFallback(category?: string): string {
  const cat = (category || "default").toLowerCase();
  const theme = EVENT_THEMES[cat] || EVENT_THEMES.default;
  return buildThemedSVG(theme, 400, 220, `ev-${cat}`);
}

const TOPIC_MAPPING: [string[], string][] = [
  [["game", "board", "بازی"], "hambazi"],
  [["coffee", "cafe", "کافه", "نشین"], "hamneshin"],
  [["breakfast", "food", "صبحانه", "غذا"], "hamgharar"],
  [["walk", "hike", "nature", "پیاده", "طبیعت"], "hamghadam"],
  [["art", "music", "هنر", "نقاشی"], "hamhonar"],
  [["study", "learn", "یادگیری", "آموز"], "hamamooz"],
  [["sport", "ورزش"], "hamvarzesh"],
  [["team", "تیم"], "hamteymi"],
  [["conversation", "گفت", "صحبت"], "hamsohbat"],
  [["story", "book", "قصه", "کتاب"], "hamghesse"],
  [["idea", "فکر", "ایده"], "hamfekr"],
  [["therapy", "روان", "مشاور"], "hamravan"],
  [["coexist", "زیست"], "hamziste"],
  [["friend", "دوست", "روانشناس"], "dustravan"],
];

export function getTopicImage(
  topic: string,
  seed = 1,
  _w = 800,
  _h = 400
): string {
  const t = topic.toLowerCase();
  for (const [keywords, cat] of TOPIC_MAPPING) {
    if (keywords.some((k) => t.includes(k))) {
      const opts = CATEGORY_KEYWORDS[cat] || CATEGORY_KEYWORDS.default;
      const kw = opts[seed % opts.length];
      return `https://loremflickr.com/800/400/${kw}?lock=${seed % 500}`;
    }
  }
  return `https://loremflickr.com/800/400/social,people,together?lock=${seed % 500}`;
}

export function getArticleImage(category: string): string {
  const cat = category.toLowerCase();
  return ARTICLE_REAL[cat] || ARTICLE_REAL.default;
}

export function getCategoryIcon(categoryId: string, _size = 200): string {
  const opts = CATEGORY_KEYWORDS[categoryId] || CATEGORY_KEYWORDS.default;
  return `https://loremflickr.com/400/220/${opts[0]}?lock=1`;
}

export function getInitialsAvatar(seed: string, _size = 128): string {
  const initial = (seed?.[0] || "ر").toUpperCase();
  let hash = 0;
  for (let i = 0; i < (seed || "x").length; i++) {
    hash = (hash << 5) - hash + (seed || "x").charCodeAt(i);
    hash |= 0;
  }
  const palette: [string, string][] = [
    ["#FF6B00", "#FF9A3C"],
    ["#7C3AED", "#A78BFA"],
    ["#0EA5E9", "#7DD3FC"],
    ["#16A34A", "#86EFAC"],
    ["#DB2777", "#F472B6"],
    ["#F59E0B", "#FCD34D"],
  ];
  const size = _size;
  const [c1, c2] = palette[Math.abs(hash) % palette.length];
  const safeId = seed?.replace(/[^a-z0-9]/gi, "x").slice(0, 8) || "av";
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 ${size} ${size}"><defs><linearGradient id="a-${safeId}" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="${c1}"/><stop offset="100%" stop-color="${c2}"/></linearGradient></defs><circle cx="${size / 2}" cy="${size / 2}" r="${size / 2}" fill="url(#a-${safeId})"/><text x="50%" y="50%" text-anchor="middle" dominant-baseline="central" font-family="Tahoma,sans-serif" font-weight="900" font-size="${size * 0.5}" fill="white">${initial}</text></svg>`;
  return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
}

export function buildEventSVG(category: string, id: string): string {
  const theme = EVENT_THEMES[category] || EVENT_THEMES.default;
  return buildThemedSVG(theme, 600, 340, `ev-${id}`);
}

export function buildArticleSVG(category: string, id: string): string {
  const theme = ARTICLE_THEMES[category] || ARTICLE_THEMES.default;
  return buildThemedSVG(theme, 600, 340, `ar-${id}`);
}
