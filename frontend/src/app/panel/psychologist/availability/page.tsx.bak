"use client";
import { useEffect, useState } from "react";
import { Calendar, Plus, Loader2, Trash2, Lock, ShieldCheck, Clock, MapPin, Video, RefreshCw } from "lucide-react";

const API = process.env.NEXT_PUBLIC_API_URL || "https://raaviiplatform.com";
const toPersian = (n: number | string) => String(n).replace(/\d/g, d => "۰۱۲۳۴۵۶۷۸۹"[+d]);

function NotApprovedBanner() {
  return (
    <div className="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
      <div className="w-20 h-20 rounded-3xl flex items-center justify-center mb-6"
        style={{ background: "rgba(245,158,11,0.12)", border: "2px solid rgba(245,158,11,0.25)" }}>
        <Lock size={32} style={{ color: "#f59e0b" }} />
      </div>
      <h2 className="text-white text-xl font-black mb-3">دسترسی محدود</h2>
      <p className="text-slate-400 text-sm max-w-sm leading-7 mb-6">
        برای ثبت برنامه زمانی و فعالیت در پنل، پروفایل شما باید توسط تیم راوی تایید شود.
        پس از تایید، تمام امکانات در دسترس خواهد بود.
      </p>
      <div className="p-4 rounded-2xl flex items-center gap-3 max-w-sm w-full"
        style={{ background: "rgba(245,158,11,0.08)", border: "1px solid rgba(245,158,11,0.2)" }}>
        <ShieldCheck size={18} style={{ color: "#f59e0b" }} />
        <div className="text-right">
          <p className="text-yellow-400 text-sm font-bold">در انتظار تایید ادمین</p>
          <p className="text-slate-500 text-xs mt-0.5">معمولاً ۱ تا ۳ روز کاری</p>
        </div>
      </div>
    </div>
  );
}

export default function AvailabilityPage() {
  const [slots, setSlots] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [submitting, setSubmitting] = useState(false);
  const [msg, setMsg] = useState("");
  const [isApproved, setIsApproved] = useState<boolean | null>(null);
  const [form, setForm] = useState({
    startDatetime: "", endDatetime: "", sessionType: "online",
    locationDescription: "", sessionDurationMinutes: 50, bufferMinutes: 10,
    repeatType: "none", repeatUntil: "",
  });

  const token = () => localStorage.getItem("token") || "";

  function load() {
    setLoading(true);
    const h = { Authorization: `Bearer ${token()}` };
    Promise.allSettled([
      fetch(`${API}/api/psychologist-verify/my-profile`, { headers: h }).then(r => r.ok ? r.json() : null),
      fetch(`${API}/api/psychologist-verify/my-slots`, { headers: h }).then(r => r.ok ? r.json() : []),
    ]).then(([p, s]) => {
      if (p.status === "fulfilled" && p.value) {
        const v = p.value?.verificationStatus || p.value?.status;
        setIsApproved(["approved","active"].includes(v));
      } else setIsApproved(false);
      if (s.status === "fulfilled") {
        const d = s.value;
        setSlots(Array.isArray(d) ? d : d?.data || []);
      }
    }).finally(() => setLoading(false));
  }
  useEffect(load, []);

  async function submit() {
    if (!form.startDatetime || !form.endDatetime) { setMsg("⚠ تاریخ شروع و پایان را پر کنید"); return; }
    setSubmitting(true); setMsg("");
    try {
      const r = await fetch(`${API}/api/psychologist-verify/availability`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token()}` },
        body: JSON.stringify(form),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d?.message || "خطا در ثبت برنامه");
      setMsg(`✅ ${toPersian(d.created_slots ?? d.createdSlots ?? 1)} اسلات ایجاد شد`);
      load();
    } catch (e: any) { setMsg(`❌ ${e.message}`); }
    finally { setSubmitting(false); }
  }

  async function deleteSlot(id: string) {
    const r = await fetch(`${API}/api/psychologist-verify/slots/${id}`, {
      method: "DELETE", headers: { Authorization: `Bearer ${token()}` },
    });
    if (r.ok) load();
  }

  if (loading) return (
    <div className="flex items-center justify-center min-h-[50vh]">
      <Loader2 size={28} className="text-emerald-400 animate-spin" />
    </div>
  );

  if (!isApproved) return <NotApprovedBanner />;

  return (
    <div dir="rtl">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-white text-xl font-black">برنامه زمانی</h1>
          <p className="text-slate-500 text-sm mt-0.5">زمان‌های آزاد خود را برای یک ماه آینده ثبت کنید</p>
        </div>
        <button onClick={load} className="w-9 h-9 rounded-xl flex items-center justify-center"
          style={{ background: "rgba(255,255,255,0.05)", border: "1px solid rgba(255,255,255,0.08)" }}>
          <RefreshCw size={15} className="text-slate-400" />
        </button>
      </div>

      {/* فرم ثبت */}
      <div className="p-5 rounded-2xl mb-6 space-y-4"
        style={{ background: "rgba(16,185,129,0.05)", border: "1px solid rgba(16,185,129,0.15)" }}>
        <div className="flex items-center gap-2 mb-2">
          <div className="w-7 h-7 rounded-lg flex items-center justify-center" style={{ background: "rgba(16,185,129,0.15)" }}>
            <Plus size={14} style={{ color: "#10b981" }} />
          </div>
          <span className="text-white font-bold text-sm">ثبت بازه زمانی جدید</span>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {[["شروع","startDatetime"],["پایان","endDatetime"]].map(([label, key]) => (
            <div key={key}>
              <label className="text-slate-400 text-xs font-bold block mb-1.5">{label}</label>
              <input type="datetime-local"
                className="w-full p-2.5 rounded-xl text-white text-sm outline-none transition-all"
                style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
                value={(form as any)[key]}
                onChange={e => setForm({ ...form, [key]: e.target.value })} />
            </div>
          ))}
        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div>
            <label className="text-slate-400 text-xs font-bold block mb-1.5">نوع جلسه</label>
            <select className="w-full p-2.5 rounded-xl text-white text-sm outline-none"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
              value={form.sessionType} onChange={e => setForm({ ...form, sessionType: e.target.value })}>
              <option value="online">آنلاین</option>
              <option value="in_person">حضوری</option>
            </select>
          </div>
          <div>
            <label className="text-slate-400 text-xs font-bold block mb-1.5">مدت (دقیقه)</label>
            <input type="number" className="w-full p-2.5 rounded-xl text-white text-sm outline-none"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
              value={form.sessionDurationMinutes}
              onChange={e => setForm({ ...form, sessionDurationMinutes: +e.target.value })} />
          </div>
          <div>
            <label className="text-slate-400 text-xs font-bold block mb-1.5">فاصله (دقیقه)</label>
            <input type="number" className="w-full p-2.5 rounded-xl text-white text-sm outline-none"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
              value={form.bufferMinutes}
              onChange={e => setForm({ ...form, bufferMinutes: +e.target.value })} />
          </div>
          <div>
            <label className="text-slate-400 text-xs font-bold block mb-1.5">تکرار</label>
            <select className="w-full p-2.5 rounded-xl text-white text-sm outline-none"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
              value={form.repeatType} onChange={e => setForm({ ...form, repeatType: e.target.value })}>
              <option value="none">بدون تکرار</option>
              <option value="weekly">هفتگی</option>
            </select>
          </div>
        </div>

        {form.sessionType === "in_person" && (
          <div>
            <label className="text-slate-400 text-xs font-bold block mb-1.5">مکان جلسه</label>
            <input className="w-full p-2.5 rounded-xl text-white text-sm outline-none"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
              placeholder="مثلاً کلینیک سعادت‌آباد، طبقه ۲"
              value={form.locationDescription}
              onChange={e => setForm({ ...form, locationDescription: e.target.value })} />
          </div>
        )}

        {form.repeatType === "weekly" && (
          <div>
            <label className="text-slate-400 text-xs font-bold block mb-1.5">تکرار تا تاریخ</label>
            <input type="date" className="w-full p-2.5 rounded-xl text-white text-sm outline-none"
              style={{ background: "rgba(255,255,255,0.06)", border: "1px solid rgba(255,255,255,0.1)" }}
              value={form.repeatUntil}
              onChange={e => setForm({ ...form, repeatUntil: e.target.value })} />
          </div>
        )}

        <button onClick={submit} disabled={submitting}
          className="flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold text-white transition-all disabled:opacity-50"
          style={{ background: "linear-gradient(135deg,#10b981,#059669)", boxShadow: "0 4px 16px rgba(16,185,129,0.3)" }}>
          {submitting ? <Loader2 size={16} className="animate-spin" /> : <Plus size={16} />}
          ثبت برنامه زمانی
        </button>

        {msg && (
          <div className="p-3 rounded-xl flex items-center gap-2"
            style={{ background: msg.startsWith("✅") ? "rgba(16,185,129,0.1)" : "rgba(239,68,68,0.1)", border: `1px solid ${msg.startsWith("✅") ? "rgba(16,185,129,0.25)" : "rgba(239,68,68,0.25)"}` }}>
            <p className="text-sm" style={{ color: msg.startsWith("✅") ? "#10b981" : "#ef4444" }}>{msg}</p>
          </div>
        )}
      </div>

      {/* لیست اسلات‌ها */}
      <div className="flex items-center justify-between mb-3">
        <h2 className="text-white font-bold text-sm">اسلات‌های فعلی</h2>
        <span className="text-slate-500 text-xs">{toPersian(slots.length)} اسلات</span>
      </div>

      {slots.length === 0 ? (
        <div className="flex flex-col items-center justify-center py-16 text-center">
          <Calendar size={32} className="text-slate-700 mb-3" />
          <p className="text-slate-500 text-sm">هنوز اسلاتی ثبت نکرده‌اید</p>
        </div>
      ) : (
        <div className="space-y-2">
          {slots.map((s: any) => {
            const start = new Date(s.start_datetime || s.startDatetime);
            const statusColor: Record<string,string> = { available: "#10b981", booked: "#3b82f6", cancelled: "#ef4444" };
            const sc = statusColor[s.status] || "#64748b";
            return (
              <div key={s.id} className="p-3 rounded-xl flex items-center justify-between group"
                style={{ background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.06)" }}>
                <div className="flex items-center gap-3">
                  <div className="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0"
                    style={{ background: `${sc}18` }}>
                    {s.session_type === "in_person" ? <MapPin size={14} style={{ color: sc }} /> : <Video size={14} style={{ color: sc }} />}
                  </div>
                  <div>
                    <p className="text-white text-sm font-bold">{start.toLocaleDateString("fa-IR", { weekday: "short", year: "numeric", month: "short", day: "numeric" })}</p>
                    <p className="text-slate-500 text-xs flex items-center gap-1">
                      <Clock size={10} />
                      {start.toLocaleTimeString("fa-IR", { hour: "2-digit", minute: "2-digit" })}
                      {" · "}{toPersian(s.session_duration_minutes || 50)} دقیقه
                    </p>
                  </div>
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-[11px] px-2 py-0.5 rounded-full font-bold"
                    style={{ background: `${sc}18`, color: sc }}>
                    {s.status === "available" ? "آزاد" : s.status === "booked" ? "رزرو شده" : s.status}
                  </span>
                  {s.status === "available" && (
                    <button onClick={() => deleteSlot(s.id)}
                      className="w-7 h-7 rounded-lg flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all"
                      style={{ background: "rgba(239,68,68,0.1)" }}>
                      <Trash2 size={12} className="text-red-400" />
                    </button>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}



